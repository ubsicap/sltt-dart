{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Sync Manager Server Runner - Start All",
            "type": "dart",
            "request": "launch",
            "program": "server_runner.dart",
            "console": "terminal",
            "cwd": "${workspaceFolder}",
            "args": ["start-all"]
        },
        {
            "name": "Sync Manager Server Runner - Start Local",
            "type": "dart",
            "request": "launch",
            "program": "server_runner.dart",
            "console": "terminal",
            "cwd": "${workspaceFolder}",
            "args": ["start", "local"]
        },
        {
            "name": "Sync Manager Server Runner - Status",
            "type": "dart",
            "request": "launch",
            "program": "server_runner.dart",
            "console": "terminal",
            "cwd": "${workspaceFolder}",
            "args": ["status"]
        },
        {
            "name": "Sync Manager Server Runner - Sync",
            "type": "dart",
            "request": "launch",
            "program": "server_runner.dart",
            "console": "terminal",
            "cwd": "${workspaceFolder}",
            "args": ["sync"]
        },
        {
            "name": "Debug AWS Backend (Dev)",
            "type": "dart",
            "request": "launch",
            "program": "packages/aws_backend/bin/debug_server.dart",
            "args": [
                "--aws-profile", "sltt-dart-dev",
                "--stage", "dev",
                "--port", "8080"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "sltt-dart-dev",
                "AWS_ACCESS_KEY_ID":  "${input:awsAccessKeyId}",
                "AWS_SECRET_ACCESS_KEY": "${input:awsSecretAccessKey}",
                "AWS_REGION": "us-east-1",
                "DYNAMODB_REGION": "us-east-1",
                "DYNAMODB_TABLE": "sltt-shared-infra-changes-states",
                "MEDIA_BUCKET": "sltt-shared-infra-media-worm-379334555674",
                "MEDIA_CLOUDFRONT_DOMAIN": "${input:mediaCloudFrontDomain}",
                "MEDIA_CLOUDFRONT_KEY_PAIR_ID": "${input:mediaCloudFrontKeyPairId}",
                "MEDIA_CLOUDFRONT_PRIVATE_KEY": "${input:mediaCloudFrontPrivateKey}",
                "SHARED_INFRA_ASSUME_ROLE_ARN": "arn:aws:iam::379334555674:role/sltt-shared-infra-cross-account-access",
                "STAGE": "dev",
                "USE_CLOUD_STORAGE": "true",
                "LOCAL_DEBUGGER": "true"
            },
            "console": "terminal"
        },
        {
            "name": "Migrate changeDataHash (Dev, dry-run)",
            "type": "dart",
            "request": "launch",
            "program": "packages/aws_backend/bin/migrate_state_data_hash.dart",
            "args": [
                "--aws-profile", "sltt-dart-dev",
                "--stage", "dev",
                "--domain-type", "project",
                "--include-test-domainIds", "false",
                "--page-size", "-1",
                "--write-changes", "false",
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "sltt-dart-dev",
                "AWS_ACCESS_KEY_ID":  "${input:awsAccessKeyId}",
                "AWS_SECRET_ACCESS_KEY": "${input:awsSecretAccessKey}",
                "AWS_REGION": "us-east-1",
                "DYNAMODB_REGION": "us-east-1",
                "DYNAMODB_TABLE": "sltt-shared-infra-changes-states",
                "MEDIA_BUCKET": "sltt-shared-infra-media-worm-379334555674",
                "MEDIA_CLOUDFRONT_DOMAIN": "${input:mediaCloudFrontDomain}",
                "MEDIA_CLOUDFRONT_KEY_PAIR_ID": "${input:mediaCloudFrontKeyPairId}",
                "MEDIA_CLOUDFRONT_PRIVATE_KEY": "${input:mediaCloudFrontPrivateKey}",
                "SHARED_INFRA_ASSUME_ROLE_ARN": "arn:aws:iam::379334555674:role/sltt-shared-infra-cross-account-access",
                "STAGE": "dev",
                "USE_CLOUD_STORAGE": "true",
                "LOCAL_DEBUGGER": "true"
            },
            "console": "terminal"
        },
        {
            "name": "Debug AWS Backend (tst)",
            "type": "dart",
            "request": "launch",
            "program": "packages/aws_backend/bin/debug_server.dart",
            "args": [
                "--aws-profile", "sltt-dart-tst",
                "--stage", "tst",
                "--port", "8080"
            ],
            "cwd": "${workspaceFolder}",
            "env": {
                "AWS_PROFILE": "sltt-dart-tst",
                "AWS_ACCESS_KEY_ID":  "${input:awsAccessKeyId}",
                "AWS_SECRET_ACCESS_KEY": "${input:awsSecretAccessKey}",
                "AWS_REGION": "us-east-1",
                "DYNAMODB_REGION": "us-east-1",
                "DYNAMODB_TABLE": "sltt-shared-infra-changes-states",
                "MEDIA_BUCKET": "sltt-shared-infra-media-worm-379334555674",
                "MEDIA_CLOUDFRONT_DOMAIN": "${input:mediaCloudFrontDomain}",
                "MEDIA_CLOUDFRONT_KEY_PAIR_ID": "${input:mediaCloudFrontKeyPairId}",
                "MEDIA_CLOUDFRONT_PRIVATE_KEY": "${input:mediaCloudFrontPrivateKey}",
                "SHARED_INFRA_ASSUME_ROLE_ARN": "arn:aws:iam::379334555674:role/sltt-shared-infra-cross-account-access",
                "STAGE": "tst",
                "USE_CLOUD_STORAGE": "true",
                "LOCAL_DEBUGGER": "true"
            },
            "console": "terminal"
        },
        {
            "name": "Attach: Debug AWS Backend (Dev)",
            "type": "dart",
            "request": "attach",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Run Dart Tests (with Isar setup)",
            "type": "dart",
            "request": "launch",
            "program": "test/",
            "preLaunchTask": "Setup Test Environment",
            "env": {
                "LD_LIBRARY_PATH": "/tmp/dart_test_libs"
            },
            "args": [
                "--reporter",
                "compact",
                "--concurrency",
                "1"
            ],
            "console": "terminal"
        },
        {
            "name": "Debug Current Dart Test (with Isar setup)",
            "type": "dart",
            "request": "launch",
            "program": "${file}",
            "preLaunchTask": "Setup Test Environment",
            "env": {
                "LD_LIBRARY_PATH": "/tmp/dart_test_libs"
            },
            "console": "terminal"
        },
        {
            "name": "Debug Current Dart Test (CLOUD_BASE_URL)",
            "type": "dart",
            "request": "launch",
            "program": "${file}",
            "env": {
                "CLOUD_BASE_URL": "${input:cloudBaseUrl}"
            },
            "console": "terminal"
        },
        {
            "name": "Start/Inspect Local Storage Server for Isar file (sltt-dart schema)",
            "type": "dart",
            "request": "launch",
            "program": "packages/sync_manager/bin/run_local_server_with_inspector.dart",
            "cwd": "${workspaceFolder}",
            "args": [
                "--db-path",
                "${input:isarDbPath}",
                "--port",
                "${input:port}",
                "--inspector",
                "true"
            ],
            "console": "terminal"
        },
    ],
    "inputs": [
        {
            "id": "awsProfile",
            "description": "AWS Profile",
            "default": "sltt-dart-dev",
            "type": "promptString"
        },
        {
            "id": "port",
            "description": "Local Server Port",
            "default": "8080",
            "type": "promptString"
        },
        {
            "id": "awsAccountId",
            "description": "AWS Account ID",
            "type": "promptString"
        },
        {
            "id": "awsAccessKeyId",
            "description": "AWS Access Key ID",
            "type": "promptString"
        },
        {
            "id": "awsSecretAccessKey",
            "description": "AWS Secret Access Key",
            "type": "promptString"
        },
        {
            "id": "isarDbPath",
            "description": "Path to Isar Database File (.isar)",
            "type": "promptString",
            "default": "./isar_db/local_storage.isar"
        },
        {
            "id": "cloudBaseUrl",
            "description": "CLOUD_BASE_URL e.g. http://localhost:8080 (leave empty to use kCloudDevUrl default)",
            "type": "promptString",
        },
        {
            "id": "mediaCloudFrontDomain",
            "description": "MEDIA_CLOUDFRONT_DOMAIN (e.g. dxxxxxxxxxxxx.cloudfront.net)",
            "type": "promptString",
        },
        {
            "id": "mediaCloudFrontKeyPairId",
            "description": "MEDIA_CLOUDFRONT_KEY_PAIR_ID",
            "type": "promptString",
        },
        {
            "id": "mediaCloudFrontPrivateKey",
            "description": "MEDIA_CLOUDFRONT_PRIVATE_KEY (PEM; you can paste with literal \\n)",
            "type": "promptString",
        }
    ]
}
